# 1. range(stop): starts at 0, goes up to stop-1
for i in range(5):
    print(i)              # 0 1 2 3 4

# 2. range(start, stop)
for i in range(2, 7):
    print(i)              # 2 3 4 5 6

# 3. range(start, stop, step)
for i in range(1, 10, 2):
    print(i)              # 1 3 5 7 9

# 4. Negative step (reverse)
for i in range(10, 0, -2):
    print(i)              # 10 8 6 4 2

for i in range(5, 0, -1):
    print(i)              # 5 4 3 2 1

# 5. Empty range (start is already past stop)
for i in range(5, 2):
    print(i)              # prints nothing

# 6. Convert range to list
print(list(range(5)))             # [0, 1, 2, 3, 4]
print(list(range(1, 10, 3)))      # [1, 4, 7]

# 7. Length, indexing, slicing
r = range(1, 11)
print(len(r))         # 10
print(r[0])           # 1
print(r[-1])          # 10
print(r[2:5])         # range(3, 6)

# 8. Membership check
print(5 in range(1, 10))     # True
print(15 in range(1, 10))    # False

# 9. Sum of numbers using range
print(sum(range(1, 101)))    # 5050

# 10. Loop over a list using index
fruits = ["apple", "banana", "mango"]
for i in range(len(fruits)):
    print(i, fruits[i])

# 11. Multiplication table
n = 5
for i in range(1, 11):
    print(n, "x", i, "=", n * i)

# 12. Even and odd numbers
for i in range(0, 11, 2):
    print(i)                  # even: 0 2 4 6 8 10
for i in range(1, 11, 2):
    print(i)                  # odd: 1 3 5 7 9
